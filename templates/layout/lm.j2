{% extends "layout/base.j2" %}
{% import "symbols/heading.j2" as hg %}
{% import "symbols/messages.j2" as messages %}
{% block body %}
    <body class="bg-black">
        <div class="shell">
            <div class="flex min-w-0 flex-col lg:flex-row">
                <div class="-mx-3 flex w-full min-w-0 flex-1 flex-wrap pt-6">
                    <aside class="w-full px-3 lg:w-1/4">
                        {% include 'symbols/left.j2' %}
                    </aside>
                    <main class="mt-12 w-full min-w-0 px-3 lg:mt-0 lg:w-3/4">
                        {{ hg.bigLmHeading(headingCategory, headingHeading) }}
                        {{ messages.lmMessages(request) }}
                        {% block main %}{% endblock %}
                    </main>
                </div>
            </div>
        </div>
    </body>
{% endblock body %}
