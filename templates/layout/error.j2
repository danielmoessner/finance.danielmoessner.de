{% if request and request.user.is_authenticated %}
    {% extends "layout/lm.j2" %}
{% else %}
    {% import "symbols/button.j2" as buttons %}
    {% extends "layout/m.j2" %}
{% endif %}
{% block main %}
    {% if request and request.user.is_authenticated %}
        <p class="mt-6">{{ message }}</p>
    {% else %}
        <div class="-mx-3 flex flex-wrap">
            <div class="w-full px-3 lg:ml-[33.333333%] lg:w-1/3">
                <div class="flex min-h-screen flex-col items-stretch justify-center">
                    <div class="mt-6 mb-6 flex items-center">
                        <img class="me-2 h-[42px] w-[42px] shrink-0"
                             src="{{ static('img/owl.svg') }}"
                             width="42"
                             height="42"
                             alt="Owl">
                        <h1 class="m-0">{{ code }} Error</h1>
                    </div>
                    <p class="mb-6">{{ message }}</p>
                    <div>{{ buttons.hrefButton(text='Go to the login page', url=url('users:signin') , classes='mb-2') }}</div>
                    <div>{{ buttons.hrefButton(text='Go to the signup page', url=url('users:signup') , classes='mb-2') }}</div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
