{% import "symbols/button.j2" as buttons %}
<nav class="flex flex-wrap items-center justify-between rounded-md bg-dark p-2 lg:items-stretch lg:bg-transparent lg:p-0">
    <a class="inline-flex shrink-0 no-underline" href="/">
        <img src="{{ static('img/owl.svg') }}"
             class="h-10 w-10"
             width="40"
             height="40"
             alt="Owl">
    </a>
    <button class="inline-flex items-center rounded-md border border-white/10 px-3 py-1 text-white lg:hidden"
            type="button"
            data-nav-toggle
            aria-controls="navbar"
            aria-expanded="false"
            aria-label="Toggle Navigation">
        <svg class="h-5 w-5"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
    </button>
    <div class="hidden w-full lg:block" id="navbar">
        <ul class="flex list-none flex-col px-0 py-4 lg:mt-0">
            <li>
                <p class="m-0 mb-2 font-bold">Dashboards</p>
            </li>
            <li>
                {{ buttons.navigationButton("Overview", url("overview:index") , active=("overview" in request.path)) }}
            </li>
            <li>
                {{ buttons.navigationButton("Banking", url("banking:index") +"?tab=accounts" , active=("banking" in request.path)) }}
            </li>
            <li>
                {{ buttons.navigationButton("Crypto", url('crypto:index') , active=("crypto" in request.path)) }}
            </li>
            <li>
                {{ buttons.navigationButton("Stocks", url('stocks:index') , active=("stocks" in request.path)) }}
            </li>
            <li>
                {{ buttons.navigationButton("Alternative", url('alternative:index') , active=("alternative" in request.path)) }}
            </li>
            <li>
                <p class="m-0 mb-2 mt-4 font-bold">User</p>
            </li>
            <li>
                {{ buttons.navigationButton("Settings", url('users:settings', args=[request.user.pk]) , active=("user" in request.path)) }}
            </li>
            <li>{{ buttons.navigationPostButton("Log Out", url('users:logout') , csrf_token) }}</li>
        </ul>
    </div>
</nav>
