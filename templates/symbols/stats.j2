{% if tab == 'stats' %}
    <div class="-mx-3 mb-12 flex flex-wrap">
        {% for key, value in stats.items() if not key == 'info' %}
            <div class="mb-4 flex w-full flex-col px-3 sm:w-1/2 md:w-1/4">
                <div class="flex h-full flex-col rounded-md border border-white/15 bg-dark text-white">
                    <div class="flex flex-1 flex-col justify-between p-4">
                        <div class="mb-2 text-xl font-medium leading-tight">{{ key }}</div>
                        {% if value is float %}
                            <p class="mb-0">{{ "%.2f"|format(value) }}</p>
                        {% else %}
                            <p class="mb-0">{{ value }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% if 'info' in stats %}<p class="text-white/50">{{ stats['info']|safe() }}</p>{% endif %}
{% endif %}
