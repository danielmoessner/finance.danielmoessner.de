{% if tab=="values" %}
    <div class="table-scroll mb-4"><table class="data-table">
        <thead>
            <tr>
                <th scope="col">Date</th>
                {% if price_and_amount %}
                    <th class="text-end" scope="col">Price</th>
                    <th class="text-end" scope="col">Amount</th>
                {% endif %}
                <th class="text-end" scope="col">Value</th>
            </tr>
        </thead>
        <tbody>
            {% for value in values() %}
                <tr>
                    <td>{{ value[0].strftime("%d.%m.%Y") }}</td>
                    <td class="text-end">{{ "%.2f"|format(value[1]) }}</td>
                    {% if price_and_amount %}
                        <td class="text-end">{{ "%.0f"|format(value[2]) }}</td>
                        <td class="text-end">{{ "%.2f"|format(value[3]) }}</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table></div>
{% endif %}
