{% macro lmMessages(request) %}
    {% with messages=get_messages(request) %}
        {% if messages %}
            <div class="messages space-y-2">
                {% for message in messages %}
                    {% if message.level <= 20 %}
                        <p class="m-0 rounded-md bg-info px-2 py-1 text-black">{{ message|safe }}</p>
                    {% elif message.level <= 25 %}
                        <p class="m-0 rounded-md bg-success px-2 py-1 text-white">{{ message|safe }}</p>
                    {% elif message.level <= 30 %}
                        <p class="m-0 rounded-md bg-warning px-2 py-1 text-black">{{ message|safe }}</p>
                    {% elif message.level >= 40 %}
                        <p class="m-0 rounded-md bg-danger px-2 py-1 text-white">{{ message|safe }}</p>
                    {% endif %}
                {% endfor %}
            </div>
            <hr class="my-2 h-px w-full border-0 bg-secondary/25">
        {% endif %}
    {% endwith %}
{% endmacro %}
