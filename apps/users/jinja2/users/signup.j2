{% extends "layout/m.j2" %}
{% set title = "Sign Up" %}
{% import "symbols/form.j2" as forms %}
{% import "symbols/button.j2" as buttons %}
{% block main %}
    <div class="-mx-3 flex flex-wrap">
        <div class="w-full px-3 lg:ml-[33.333333%] lg:w-1/3">
            <div class="flex min-h-screen flex-col items-stretch justify-center">
                <div class="mt-6 mb-12 flex items-center">
                    <img class="me-2 h-[42px] w-[42px] shrink-0"
                         src="{{ static('img/owl.svg') }}"
                         width="42"
                         height="42"
                         alt="Owl">
                    <h1 class="m-0">Sign up</h1>
                </div>
                <div class="mb-12">
                    {{ forms.formGenerator(form, url('users:signup') , csrf_token, submit_button_text='Sign up', submit_button_classes='ms-auto', form_classes='djangoform-dark') }}
                </div>
                <div>{{ buttons.hrefButton(text='Go to the login page', url=url('users:signin') , classes='mb-4') }}</div>
            </div>
        </div>
    </div>
{% endblock %}
