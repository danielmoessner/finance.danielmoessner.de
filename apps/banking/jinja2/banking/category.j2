{% extends "layout/lm.j2" %}
{% set headingCategory = "Category" %}
{% set headingHeading = category.name %}
{% set title = "Category " + category.name + " | Banking" %}
{% block main %}
    {% import "symbols/button.j2" as bg %}
    {% import "symbols/modal.j2" as mg %}
    <div class="mt-2 mb-12 flex justify-center">
        <div class="tab-group" role="group" aria-label="Console">
            {{ bg.hrefButton("Stats", request.path + '?tab=stats', active=(tab=='stats') ) }}
            {{ bg.hrefButton("Changes", request.path + '?tab=changes', active=(tab=='changes') ) }}
        </div>
    </div>
    {% include 'symbols/stats.j2' %}
    {% if tab=='changes' %}
        {{ mg.djangoModal('Edit Change', 'editChange') }}
        {{ mg.djangoModal('Delete Change', 'deleteChange') }}
        {{ mg.djangoModal('Add Change', 'addChange') }}
        {{ mg.djangoModal('Combine Change', 'combineChange') }}
        {{ mg.djangoModal('Change Category', 'changeCategory') }}
        <div class="table-scroll mb-12"><table class="data-table">
            <thead>
                <tr class="category-change-toolbar hidden">
                    <th colspan="6">
                        <div class="flex items-center gap-4">
                            <span class="category-change-selection-count"></span>
                            <span class="category-change-selection-sum"></span>
                            {{ bg.modalButton("Change Category", "#changeCategory", url('banking:bulk_change_category', args=[category.pk]), "category-change-bulk-button") }}
                        </div>
                    </th>
                </tr>
                <tr>
                    <th scope="col">
                        <input class="category-change-select-all size-4 cursor-pointer accent-info align-middle"
                               type="checkbox"
                               aria-label="Select all changes">
                    </th>
                    <th scope="col">Date</th>
                    <th scope="col">Account</th>
                    <th scope="col">Description</th>
                    <th class="text-end" scope="col">Change</th>
                    <th class="text-end" scope="col">
                        {{ bg.modalButton('Add Change', '#addChange', url("banking:add_change") +"?category="+category.pk|string) }}
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for change in changes %}
                    <tr>
                        <td>
                            <input class="category-change-selection size-4 cursor-pointer accent-info align-middle"
                                   type="checkbox"
                                   value="{{ change.pk }}"
                                   data-amount="{{ change.change }}"
                                   aria-label="Select change">
                        </td>
                        <td>{{ localtime(change.date).strftime('%d.%m.%Y %H:%M') }}</td>
                        <td>{{ change.account }}</td>
                        <td>{{ change.get_description() }}</td>
                        <td class="text-end">{{ change.change }}</td>
                        <td>
                            <div class="flex justify-end gap-1">
                                {{ bg.modalButton("C", "#combineChange", url("banking:combine_change", args=[change.pk]) ) }}
                                {{ bg.modalButton("Edit", "#editChange", url("banking:edit_change", args=[change.pk]) ) }}
                                {{ bg.modalButton("Delete", "#deleteChange", url("banking:delete_change", args=[change.pk]) ) }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                <tr>
                    <td colspan="6">
                        {{ bg.modalButton("Add Change", "#addChange", url("banking:add_change") +"?category="+category.pk|string) }}
                    </td>
                </tr>
            </tbody>
        </table></div>
    {% endif %}
{% endblock %}
